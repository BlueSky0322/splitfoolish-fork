{
  "name": "boujee-splitwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "preview": "vite preview",
    "postinstall": "husky install",
    "prepare": "husky install",
    "deploy": "yarn build && wrangler deploy",
    "dev:worker": "yarn build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply splitfoolish-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply splitfoolish-db --local"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^7.9.1",
    "@mantine/form": "^7.9.1",
    "@mantine/hooks": "^7.9.1",
    "@mantine/modals": "^7.9.2",
    "@mantine/notifications": "^7.9.2",
    "@phosphor-icons/react": "2.1.7",
    "@tanstack/react-query": "5.104.2",
    "clsx": "^2.1.1",
    "hono": "4.13.13",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6",
    "immer": "^10.1.1",
    "mathjs": "^12.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.3.0",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^9.3.0",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "9.x",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.71.2",
    "vite": "^5.2.0",
    "vite-plugin-mkcert": "^1.17.5",
    "vitest": "^1.6.0",
    "wrangler": "4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.css": "prettier --write",
    "*.{js,css,md}": "prettier --write"
  }
}
