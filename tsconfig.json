{
  // The build configs and the build's own code (web/build), run by Node. worker/test extends it for the Worker tests; the app,
  // the Worker and shared code each have their own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.config.ts", "web/*.config.ts", "web/build"]
}
