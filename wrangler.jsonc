{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitfoolish",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Runs the Worker near the D1 database when that is faster than near the visitor
  "placement": { "mode": "smart" },
  // Cloudflare Access app protecting this Worker. The API refuses every request
  // until both are set. Locally, .dev.vars blanks them and sets DEV_USER_EMAIL.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ryanng-0611.cloudflareaccess.com",
    "ACCESS_AUD": "0b9d523eaa0a5d680e662443a9922d5be39edf752659882fef24b4f1dda5438b",
    // Where the app lives: names the MCP resource (MCP_ORIGIN/mcp) and its OAuth issuer
    "MCP_ORIGIN": "https://splitfoolish.shitty-app.workers.dev",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, and MCP with its OAuth routes, which must never get the app's page
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"],
  },
  // A room per split that tells everyone with it open when it changes
  "durable_objects": { "bindings": [{ "name": "SPLIT_ROOM", "class_name": "SplitRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SplitRoom"] }],
  // Logs and traces in the dashboard, for a tenth of requests
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Caps how many changes each account can make a minute (reads are not counted)
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  // Currency conversions to retry after a failed first attempt (worker/currency/reconvert-queue.ts).
  // Both queues must exist before a deploy with this config: `wrangler queues create`
  "queues": {
    "producers": [{ "binding": "RECONVERT_QUEUE", "queue": "reconvert" }],
    "consumers": [
      {
        "queue": "reconvert",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "reconvert-dlq",
      },
      { "queue": "reconvert-dlq", "max_batch_size": 10, "max_retries": 0 },
    ],
  },
  // OAuth clients, grants and tokens for MCP (worker/mcp/oauth.ts). Locally it's simulated.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "463af12a36d3433f87e44fbd4a6221b6" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitfoolish-db",
      "database_id": "318166d8-116e-4922-877f-9e98dd357dd1",
      "migrations_dir": "migrations",
    },
  ],
}
